# ===== BẮT BUỘC =====
DISCORD_TOKEN=
MOTAPIS_API_KEY=

# ===== AI (motapis) =====
AI_BASE_URL=https://motapis.com/v1
AI_MODEL=DeepSeek-V4-Flash-0731
# Muốn bot trả lời nhanh hơn trong voice, thử tắt thinking (nếu API hỗ trợ):
# AI_EXTRA_BODY={"thinking":{"type":"disabled"}}
AI_MAX_TOKENS=1500
# Model dự phòng khi model chính lỗi/hết quota (tùy chọn)
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=60000

# ===== BOT =====
BOT_NAME=Bot Mất Dạy
# Các từ gọi tên bot (cách nhau dấu phẩy). Nhắc tới là bot trả lời.
BOT_NAMES=bot
# ID Discord của bạn (và người tin cậy) – luôn được coi là admin của bot. Cách nhau dấu phẩy
ADMIN_IDS=
# Hỏi xác nhận trước lệnh nguy hiểm (kick/ban/xóa kênh/xóa role/purge nhiều/lockdown)
CONFIRM_DANGEROUS=true

# ===== NHẬN DIỆN GIỌNG NÓI (STT) =====
# KHUYẾN NGHỊ khi host yếu (Falix free: Whisper cục bộ mất ~25s/câu): dùng STT đám mây, miễn phí tại console.groq.com
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_LANG=vi

# ===== VOICE =====
VOICE_MAX_SECS=20        # độ dài tối đa 1 câu nói
VOICE_SILENCE_MS=900     # im lặng bao lâu thì coi là hết câu
VOICE_MIN_RMS=250        # dưới ngưỡng này coi là tiếng ồn
VOICE_MIN_SECS=0.6       # câu ngắn hơn thì bỏ
VOICE_BARGE_MS=450       # phải nói liên tục bấy lâu mới ngắt lời bot (chống ho/tiếng ồn)

# ===== TÌM KIẾM WEB (tùy chọn, ổn định hơn DuckDuckGo) =====
TAVILY_API_KEY=

# ===== NHẠC =====
# Nếu YouTube chặn IP server ("confirm you're not a bot"): xuất cookies.txt rồi base64 dán vào đây
YT_COOKIES_B64=
YTDLP_ARGS=--js-runtimes node

# ===== LƯU DỮ LIỆU =====
# Gắn Render Disk vào /data rồi đặt DATA_DIR=/data để giữ cấu hình sau khi restart
DATA_DIR=./data

# Local Whisper (không cần STT API key)
WHISPER_CLI_PATH=./bin/whisper-cli
WHISPER_MODEL_PATH=./models/ggml-tiny.bin
WHISPER_LANGUAGE=vi
WHISPER_THREADS=1
WHISPER_TIMEOUT_MS=45000
# Tham số cho whisper-cli (mặc định: giải mã tham lam cho nhanh). Thử thêm: -nfa -ac 768
WHISPER_EXTRA_ARGS=-bs 1 -bo 1 -nf
# FFmpeg phải có trên máy chủ Falix để chuyển Edge TTS MP3 sang PCM
FFMPEG_PATH=ffmpeg
